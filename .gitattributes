# Normalize line endings so a checkout looks the same on every platform.
#
# Without this file, a contributor on Windows with core.autocrlf=true gets working
# files with CRLF while the repository stores LF. gofmt reports every one of those
# files as unformatted, and a save can rewrite the whole file's endings, burying a
# real change under thousands of line-ending diffs.
#
# The repository is LF throughout; keep it that way everywhere.

* text=auto eol=lf

# Go and the tooling around it
*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.tmpl text eol=lf

# Config, docs and data
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
.env.example text eol=lf
Makefile     text eol=lf
Dockerfile   text eol=lf

# Windows-only files do want CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never line-ending conversions or textual diffs on these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.mkv  binary
*.mp4  binary
*.webm binary
*.wasm binary

# Generated or vendored: exclude from diff noise where possible
go.sum text eol=lf -diff
