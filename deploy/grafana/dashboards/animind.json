{
  "uid": "animind-operations",
  "title": "AniMind Operations",
  "tags": ["animind", "api", "redis"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": { "type": "grafana", "uid": "grafana" },
        "enable": true,
        "iconColor": "blue",
        "builtIn": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API up",
      "description": "Scrape success for the metrics listener. Zero means the API is down or Prometheus cannot reach port 3002.",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"animind-api\"}",
          "legendFormat": "api"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx rate",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(animind_http_requests_total{status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Credential cache hit ratio",
      "description": "Share of cache reads answered by the store. A low ratio on the credential path means authorization is still going to Postgres.",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(animind_cache_operations_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(animind_cache_operations_total{result=~\"hit|miss\"}[5m])), 0.001)",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.8 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Shared state",
      "description": "One when Redis backs sessions and rate limits, zero when the API is counting inside its own process.",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "animind_cache_shared",
          "legendFormat": "shared"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "IN-PROCESS", "color": "orange" }, "1": { "text": "REDIS", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Watch parties",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "animind_watchparty_rooms", "legendFormat": "rooms" },
        { "refId": "B", "expr": "animind_watchparty_peers", "legendFormat": "peers" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Library",
      "description": "Shows and episodes this API can serve.",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "animind_library_entries{kind=\"shows\"}", "legendFormat": "shows" },
        { "refId": "B", "expr": "animind_library_entries{kind=\"episodes\"}", "legendFormat": "episodes" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests per second by route",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (route, method) (rate(animind_http_requests_total[2m])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency by route (p50 / p95)",
      "description": "Media and HLS routes legitimately stream for a long time; compare them against the JSON routes rather than one shared threshold.",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.5, sum by (le, route) (rate(animind_http_request_duration_seconds_bucket[2m]))))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "refId": "B",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(animind_http_request_duration_seconds_bucket[2m]))))",
          "legendFormat": "p95 {{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Status codes",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(animind_http_requests_total[2m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 12, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Rate-limit denials and 429s",
      "description": "The store counts window verdicts; the route table counts responses. They should move together, and a gap is a limiter failing open.",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(animind_cache_operations_total{result=\"deny\"}[2m]))", "legendFormat": "denied by window" },
        { "refId": "B", "expr": "sum by (route) (rate(animind_http_requests_total{status=\"429\"}[2m]))", "legendFormat": "429 {{route}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cache operations",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(animind_cache_operations_total[2m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Rate-limit verdicts taken locally",
      "description": "Redis stopped answering. Until this climbs the shared budget is real; while it is above zero each process enforces its own.",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "rate(animind_rate_limit_fallbacks_total[2m])", "legendFormat": "local verdicts/s" },
        { "refId": "B", "expr": "sum(rate(animind_cache_operations_total{result=\"error\"}[2m]))", "legendFormat": "store errors/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Postgres pool",
      "description": "Active against the configured maximum. Pinned at the ceiling means requests are queueing, not that the queries are slow.",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "animind_db_connections_active", "legendFormat": "active" },
        { "refId": "B", "expr": "animind_db_connections_idle", "legendFormat": "idle" },
        { "refId": "C", "expr": "animind_db_connections_max", "legendFormat": "max" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Process",
      "datasource": { "type": "prometheus", "uid": "animind-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "go_memstats_heap_inuse_bytes", "legendFormat": "heap in use" },
        { "refId": "B", "expr": "go_goroutines", "legendFormat": "goroutines" },
        { "refId": "C", "expr": "rate(process_cpu_seconds_total[2m])", "legendFormat": "cpu cores" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "heap in use" }, "properties": [ { "id": "unit", "value": "bytes" } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
