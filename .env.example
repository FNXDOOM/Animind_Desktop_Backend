# =====================================================================
# Animind backend (Go) - environment configuration
# =====================================================================
# Copy to .env and fill in the secrets. The server refuses to start when a
# required value is missing, and names the variable in the error message.
#
# Nothing here is a frontend setting: this process serves the API for the
# desktop player and the website, and serves no browser code.

# --- Server ---
PORT=3001
ENV=development
# This API's public origin. Used as the token issuer and to build OAuth
# callbacks. Without it, the first FRONTEND_URL entry is used.
PUBLIC_URL=http://localhost:3001
# Comma-separated origins allowed to call the API from a browser. Use an
# explicit list; "*" is accepted but disables origin checking.
FRONTEND_URL=http://localhost:5173,https://yourdomain.in
# Comma-separated HTTPS origins the OAuth callback may return to, which is how a
# native app receives its one-time code through a verified app link. Paths,
# queries, fragments, userinfo, wildcards and http entries are rejected.
# APP_LINK_ORIGINS=https://app.yourdomain.in
# Shared secret required in the x-webhook-secret header by storage webhooks.
WEBHOOK_SECRET=change-me
# Set true ONLY when a reverse proxy in front of this process overwrites
# X-Forwarded-For. Otherwise clients could forge the header to escape rate limits.
TRUST_PROXY_HEADERS=false

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# json (default in production) | text (default elsewhere)
LOG_FORMAT=

# --- Database (required) ---
# Any Postgres 14+ works, including a hosted or Supabase Postgres endpoint.
# The backend owns its schema and applies migrations on boot unless disabled.
DATABASE_URL=postgres://user:password@localhost:5432/animind?sslmode=require
DB_MAX_CONNS=12
DB_MIN_CONNS=1
DB_PING_TIMEOUT_SECONDS=10
# Set false to apply migrations only with `server --migrate-only` or psql.
DB_AUTO_MIGRATE=true

# --- Shared state (Redis) ---
# Optional. Empty keeps cached sessions, rate-limit windows and AniList documents inside this
# process, which is correct for a single instance. When set, the server FAILS TO START if the
# address does not answer: a half-wired cache is the misconfiguration this backend refuses to
# boot on. A Redis that dies later degrades instead (misses go to Postgres, rate limits fall
# back to per-process windows).
# Nothing is durable here: a restart costs cache hits and one open rate-limit window.
REDIS_URL=redis://localhost:6379/0
# Key prefix, so one Redis can hold several stacks. Letters, digits, dash and underscore only.
CACHE_NAMESPACE=animind
# How long a resolved credential is served from cache. Short on purpose: it bounds how long a
# revocation that no code path announces could survive. Values above 60s are clamped to the
# session touch interval, so raising it does not delay expiry either.
CACHE_SESSION_TTL_SECONDS=60
# How long a proxied AniList document and a resolved scan title are reused.
CACHE_METADATA_TTL_HOURS=12
# Every cache call sits in front of authentication, so both timeouts are aggressive: on expiry
# the request goes to Postgres instead of waiting on Redis.
CACHE_DIAL_TIMEOUT_MS=500
CACHE_COMMAND_TIMEOUT_MS=250
CACHE_MAX_CONNECTIONS=20

# --- Metrics (Prometheus) ---
# A separate, unauthenticated listener: nginx does not proxy it and compose does not publish
# it. Bind to loopback unless a scraper on another host needs it.
METRICS_ENABLED=true
METRICS_ADDR=127.0.0.1:3002
METRICS_PATH=/metrics

# --- Authentication ---
# Signs desktop access tokens and playback tickets. Generate one and keep it
# private: openssl rand -base64 48
# Required, minimum 32 characters. Changing it invalidates every desktop
# session and outstanding ticket.
DESKTOP_TOKEN_SIGNING_KEY=replace-with-a-long-random-secret
# Desktop access token lifetime (the player refreshes 30s before expiry).
DESKTOP_ACCESS_TOKEN_TTL_SECONDS=900
DESKTOP_REFRESH_TOKEN_TTL_DAYS=30
# Site session lifetimes.
WEB_SESSION_TTL_HOURS=24
REMEMBER_ME_TTL_DAYS=30
# argon2id cost factors. Defaults follow the OWASP second choice.
ARGON2_TIME=3
ARGON2_MEMORY_KIB=65536
ARGON2_THREADS=4
# Account lockout for repeated password failures on one account.
AUTH_MAX_FAILED_LOGINS=10
AUTH_FAILED_LOGIN_LOCKOUT_MINUTES=15
# Serve the session cookie with Secure. Defaults to true when ENV=production.
SECURE_COOKIES=
# Set false to freeze signup on an existing deployment (login still works).
ALLOW_SIGNUP=true
# Prune revoked and long-expired desktop sessions.
DESKTOP_AUTH_CLEANUP_ENABLED=true
DESKTOP_AUTH_CLEANUP_CRON=30 2 * * *
DESKTOP_AUTH_EXPIRED_RETENTION_DAYS=7

# --- Google sign-in (optional) ---
# Register the callback URL from GOOGLE_REDIRECT_URL in Google Cloud Console.
# Without both values the website's Google button answers 501.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3001/api/auth/google/callback

# --- Storage: choose one mode ---
# s3    -> videos live in an S3-compatible bucket (R2, Spaces, MinIO, AWS)
# local -> videos live on this machine's filesystem
STORAGE_MODE=s3

S3_BUCKET_NAME=your-bucket-name
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# Lifetime of a presigned stream URL, in seconds.
S3_PRESIGN_EXPIRES=14400
# Lifetime of a signed playback ticket, in seconds (minimum 120).
STREAM_TICKET_TTL_SECONDS=14400
# Bytes per range response for browser clients.
STREAM_RANGE_CHUNK_MB=8
# Bytes per range response for the native desktop player.
STREAM_NATIVE_RANGE_CHUNK_MB=32

# Used when STORAGE_MODE=local. Must exist and be readable.
LOCAL_STORAGE_PATH=/mnt/anime

# --- Scanner ---
SCANNER_ENABLED=true
SCANNER_CRON=0 */6 * * *
# Index once at boot (background, non-blocking).
SCANNER_ON_STARTUP=false
# Comma-separated video extensions to index.
VIDEO_EXTENSIONS=mkv,mp4,avi,webm,m4v
# Delete episodes whose file disappeared and shows left without episodes.
SCANNER_PRUNE_DELETED=true
# Consult the LLM fallback for filenames no rule matched. Needs OPENROUTER_*.
SCANNER_OPENROUTER_FALLBACK=false

# --- Metadata providers ---
ANILIST_ENABLED=true
MYANIMELIST_ENABLED=true
MYANIMELIST_CLIENT_ID=your-mal-client-id
# Per-title cache lifetime; a scan touches the same title hundreds of times.
METADATA_CACHE_TTL_HOURS=24

# --- OpenRouter scanner fallback (optional) ---
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://yourdomain.in
OPENROUTER_APP_NAME=Animind
OPENROUTER_TIMEOUT_MS=12000
OPENROUTER_MIN_CONFIDENCE=0.72

# --- FFmpeg / FFprobe (local mode: subtitles, audio variants, HLS) ---
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
# Lower priority for background conversions on POSIX hosts (0 disables).
FFMPEG_NICE=19
FFMPEG_TIMEOUT_SECONDS=120

# --- HLS sessions (local mode, browser playback) ---
# Segment length in seconds, clamped to 2-30.
HLS_SEGMENT_DURATION=10
# Concurrent ffmpeg remuxes; the least recently used is evicted at the cap.
HLS_MAX_CONCURRENT_SESSIONS=2
# Destroy a session nobody has touched for this long.
HLS_SESSION_TIMEOUT_MINUTES=120
# How long to wait for the first segment before failing the session.
HLS_READY_TIMEOUT_MS=15000
# Where playlists and segments are written. Defaults to <tmp>/animind-hls.
HLS_ROOT_DIR=

# --- Audio variant cache (local mode) ---
POST_SCAN_AUDIO_PREWARM_ENABLED=true
POST_SCAN_AUDIO_PREWARM_EPISODE_LIMIT=12
POST_SCAN_AUDIO_PREWARM_MAX_TRACKS_PER_EPISODE=1
AUDIO_CACHE_VARIANT_CLEANUP_ENABLED=true
AUDIO_CACHE_VARIANT_CLEANUP_CRON=15 */6 * * *
AUDIO_CACHE_VARIANT_TTL_DAYS=14

# --- Watch parties (SyncPlay) ---
SYNCPLAY_ENABLED=true
SYNCPLAY_READY_TIMEOUT_MS=12000
SYNCPLAY_BUFFER_GOAL_SECONDS=120
SYNCPLAY_SOFT_SEEK_THRESHOLD_MS=200
SYNCPLAY_SPEED_SYNC_MAX_MS=10000
SYNCPLAY_ESCAPE_BUFFER_SECONDS=30
SYNCPLAY_ESCAPE_WAIT_MS=10000
# How long a peer's position must stay frozen before it counts as stalling.
SYNCPLAY_STALL_DETECT_MS=2000
# Grace before a stalling peer forces the room to re-gate.
SYNCPLAY_STALL_GRACE_MS=5000
# Hard cap on one gate. After this the room starts whatever the buffers look like.
SYNCPLAY_WAIT_DEADLINE_MS=30000
# Scheduled-start lead: now + clamp(2 x slowest member ping, MIN, MAX). The floor matters more
# than the ceiling — a room with a zero lead starts on packet arrival, which is the bug.
SYNCPLAY_START_LEAD_MIN_MS=500
SYNCPLAY_START_LEAD_MAX_MS=4000
# Clamp on a member's self-reported round trip, so one client cannot push a start minutes out.
SYNCPLAY_MAX_PING_MS=10000
# Buffer goal is min(GOAL_SECONDS, FRACTION x seconds of episode remaining), 10 s floor.
SYNCPLAY_BUFFER_GOAL_FRACTION=0.1
# Published to clients in syncConfig; the server does not act on these itself.
SYNCPLAY_SLOWDOWN_RATE=0.95
SYNCPLAY_SPEEDUP_RATE=1.05
SYNCPLAY_CORRECTION_ENGAGE_DRIFT_MS=1500
SYNCPLAY_CORRECTION_RELEASE_DRIFT_MS=100
SYNCPLAY_FAST_FORWARD_DRIFT_MS=5000
SYNCPLAY_MAX_PLAYBACK_OFFSET_MS=500
SYNCPLAY_MAX_CATCHUP_OFFSET_MS=20000
SYNCPLAY_TIMESYNC_WINDOW=8
SYNCPLAY_TIMESYNC_DEADBAND_MS=120
SYNCPLAY_TIMESYNC_MAX_AGE_MS=150000
SYNCPLAY_TIMESYNC_GREEDY_MS=1000
SYNCPLAY_TIMESYNC_IDLE_MS=15000
SYNCPLAY_TIMESYNC_PAUSED_MS=60000
# Ack deadline a client holds createRoom/joinRoom to.
SYNCPLAY_PROTOCOL_TIMEOUT_MS=12500
SYNCPLAY_MAX_PARTICIPANTS=12
SYNCPLAY_MAX_MESSAGE_BYTES=65536
SYNCPLAY_PING_INTERVAL_SECONDS=25
SYNCPLAY_WRITE_TIMEOUT_SECONDS=10
SYNCPLAY_PONG_TIMEOUT_SECONDS=40
SYNCPLAY_ENDED_CLEANUP_ENABLED=true
SYNCPLAY_CLEANUP_CRON=*/10 * * * *
SYNCPLAY_ENDED_TTL_MINUTES=60
