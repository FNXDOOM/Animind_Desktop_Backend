# Editor defaults, matching .gitattributes and gofmt.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{go,mod,sum}]
indent_style = tab
indent_size = tab
tab_width = 4

[*.{yml,yaml,json,sql,html,css,js}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.py]
indent_style = space
indent_size = 4
